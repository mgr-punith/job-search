# Local PostgreSQL connection used for development.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jobsearch?schema=public"

# Separate local PostgreSQL database used by integration tests from M1 onward.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jobsearch_test?schema=public"

# Production uses a Neon PostgreSQL URL set in the deployment environment.

# Used by the simulated application status engine in M5.
DEMO_STATUS_DELAY_SECONDS="60"

# Generate a strong secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
# Local app origin in development; set this to the deployed HTTPS origin in production.
BETTER_AUTH_URL="http://localhost:3000"

# Added in M3 when UploadThing is installed.
UPLOADTHING_TOKEN="replace-with-uploadthing-token"

# Optional free-tier AI profile suggestions. Keep the API key on the server.
GROQ_API_KEY="replace-with-groq-api-key"
GROQ_MODEL="openai/gpt-oss-20b"
